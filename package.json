{
	"name": "mdat-plugin-api",
	"version": "0.2.0",
	"description": "Mdat plugin to generate API documentation from TypeScript source files using JSDoc and type information.",
	"keywords": [
		"markdown",
		"mdat-plugin",
		"mdat",
		"api",
		"typedoc",
		"typescript",
		"documentation"
	],
	"homepage": "https://github.com/kitschpatrol/mdat-plugin-api",
	"bugs": "https://github.com/kitschpatrol/mdat-plugin-api/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/mdat-plugin-api.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"files": [
		"dist/*"
	],
	"scripts": {
		"build": "tsdown --no-fixed-extension --tsconfig tsconfig.build.json",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run --no-file-parallelism"
	},
	"dependencies": {
		"lognow": "^0.8.4",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.13.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@kitschpatrol/shared-config": "^8.10.1",
		"@types/node": "~24.13.3",
		"bumpp": "^12.3.0",
		"mdat": "^3.4.1",
		"shx": "^0.4.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.2"
	},
	"peerDependencies": {
		"mdat": "^3.0.0",
		"typescript": "^5.0.0 || ^6.0.0"
	},
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
