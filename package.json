{
  "name": "mdat-plugin-api",
  "version": "0.1.0",
  "description": "Mdat plugin to generate API documentation from TypeScript source files using JSDoc and type information.",
  "keywords": [
    "markdown",
    "mdat-plugin",
    "mdat",
    "api",
    "typedoc",
    "typescript",
    "documentation",
    "npm-package"
  ],
  "homepage": "https://github.com/kitschpatrol/mdat-plugin-api",
  "bugs": "https://github.com/kitschpatrol/mdat-plugin-api/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitschpatrol/mdat-plugin-api.git"
  },
  "license": "MIT",
  "author": {
    "name": "Eric Mika",
    "email": "eric@ericmika.com",
    "url": "https://ericmika.com"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "bench": "vitest bench --run --no-file-parallelism --compare test/benchmarks/baseline.json",
    "bench:baseline": "vitest bench --run --no-file-parallelism --outputJson test/benchmarks/baseline.json",
    "build": "tsdown --no-fixed-extension --tsconfig tsconfig.build.json",
    "clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
    "fix": "ksc fix",
    "lint": "ksc lint",
    "release": "bumpp --commit 'Release: %s' && pnpm build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish",
    "test": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "lognow": "^0.6.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kitschpatrol/shared-config": "^7.6.0",
    "@types/node": "~22.17.2",
    "bumpp": "^11.1.0",
    "mdat": "link:../mdat",
    "shx": "^0.4.0",
    "tsdown": "^0.22.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "mdat": "^2.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.17.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.21.0"
    }
  }
}
